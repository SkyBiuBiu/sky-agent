# 环境变量示例：复制为 .env 后填写本地值
# 注意：不要提交真实密钥

# 服务端口（启动脚本会自动分配，通常无需手动设置）
BACKEND_PORT=
FRONTEND_PORT=

# 运行环境
ENVIRONMENT=
IS_LAMBDA=false

# 模型接口配置：默认在站点的「模型配置」页面填写并保存，无需写入环境变量
# 如需通过环境变量预置，可使用以下变量名
# MODEL_BASE_URL=
# MODEL_NAME=
# MODEL_API_KEY=

# 以下能力由 Atoms Cloud 平台在运行时注入，本地运行时需要平台提供
# DATABASE_URL=
# AUTH_SECRET=
